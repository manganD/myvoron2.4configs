[gcode_macro PRINT_START]
description: Pre-print sequence with 30-min heat soak for V2.4 350 AWD
gcode:
    # ------------------------------------------------------------------
    # 1. PULL VARIABLES FROM SLICER
    # ------------------------------------------------------------------
    {% set target_bed = params.BED|int %}                  # Target bed temp from slicer
    {% set target_extruder = params.EXTRUDER|int %}        # Target hotend temp from slicer
    {% set soak_minutes = 30 %}                            # Heat soak duration in minutes for high-temp prints
    
    # Calculate the center of your 350x350 bed dynamically
    {% set x_wait = printer.toolhead.axis_maximum.x|float / 2 %}
    {% set y_wait = printer.toolhead.axis_maximum.y|float / 2 %}

    # ------------------------------------------------------------------
    # 2. INITIAL HOMING & BED HEATING
    # ------------------------------------------------------------------
    M117 Homing...                                         # Update Knomi / screen status
    G28                                                    # Home all axes (X, Y, Z)
    G90                                                    # Set to absolute positioning
    BED_MESH_CLEAR                                         # Clear any old bed mesh

    # Start heating the bed
    M140 S{target_bed}
    G1 X{x_wait} Y{y_wait} Z15 F9000                       # Move toolhead to center of bed

    # ------------------------------------------------------------------
    # 3. HEAT SOAK & AIR MANAGEMENT
    # ------------------------------------------------------------------
    {% if target_bed > 90 %}
        # High-temp filament (ABS/ASA): Turn on Nevermore, seal chamber, wait for bed + 30 min soak
        SET_FAN_SPEED FAN=nevermore SPEED=1.0              # Nevermore at 100% to circulate hot air
        SET_FAN_SPEED FAN=exhaust_fan SPEED=0.0            # Exhaust OFF to trap heat
        
        M117 Heating Bed...
        M190 S{target_bed}                                 # Wait for 750W Keenovo to hit target temp

        # Loop 30 times, waiting 1 minute (60,000 ms) per loop and updating screen
        {% for i in range(soak_minutes) %}
            {% set remaining = soak_minutes - i %}
            M117 Soaking: {remaining}m left                # Displays countdown on Knomi / console
            G4 P60000                                      # Pause for 60 seconds
        {% endfor %}
    {% else %}
        # Low-temp filament (PLA/PETG): No heat soak needed
        M117 Heating Bed...
        SET_FAN_SPEED FAN=nevermore SPEED=0.0              # Nevermore OFF
        SET_FAN_SPEED FAN=exhaust_fan SPEED=0.5            # Exhaust at 50% to prevent heat creep
        M190 S{target_bed}                                 # Wait for bed temp
    {% endif %}

    # ------------------------------------------------------------------
    # 4. VORON TAP SAFE PROBING (NOZZLE AT 150C)
    # ------------------------------------------------------------------
    M117 Heating Nozzle to 150C...
    M109 S150                                              # Heat nozzle to 150C (safe for Tap)

    M117 Quad Gantry Leveling...
    QUAD_GANTRY_LEVEL                                      # Level the 4 Z drives
    G28 Z                                                  # Re-home Z after gantry is leveled (CRITICAL for Tap)

    # ------------------------------------------------------------------
    # 5. ADAPTIVE BED MESH & FINAL HEATING
    # ------------------------------------------------------------------
    M117 Adaptive Bed Meshing...
    BED_MESH_CALIBRATE ADAPTIVE=1                          # Requires [exclude_object] in printer.cfg

    M117 Heating Hotend...
    G1 X10 Y10 Z15 F9000                                   # Move near front-left corner while heating
    M109 S{target_extruder}                                # Heat nozzle to full printing temperature

    # Simple Purge Line at front of 350mm bed
    M117 Purging...
    G92 E0                                                 # Reset extruder position
    G1 X10 Y5 Z0.3 F5000.0                                 # Move to start position
    G1 X160 Y5 Z0.3 F1500.0 E15                            # Draw first line
    G1 X160 Y5.4 Z0.3 F5000.0                              # Shift over slightly
    G1 X10 Y5.4 Z0.3 F1500.0 E30                           # Draw second line
    G92 E0                                                 # Reset extruder again
    G1 Z2.0 F3000                                          # Lift nozzle slightly before starting print

    M117 Printing!


[gcode_macro PRINT_END]
description: Post-print sequence, safe parking, and VOC air scrub
gcode:
    # ------------------------------------------------------------------
    # 1. SAVE BOUNDARIES & CURRENT POSITION
    # ------------------------------------------------------------------
    # Grab max travel limits from printer.cfg so we never crash into the frame
    {% set max_x = printer.toolhead.axis_maximum.x|float %}
    {% set max_y = printer.toolhead.axis_maximum.y|float %}
    {% set max_z = printer.toolhead.axis_maximum.z|float %}
    {% set current_z = printer.toolhead.position.z|float %}

    # Calculate safe Z lift (lift 20mm, or stop 5mm short of top frame if print is very tall)
    {% if current_z < (max_z - 25) %}
        {% set z_safe = 20.0 %}
    {% else %}
        {% set z_safe = max_z - current_z - 5.0 %}
    {% endif %}

    # Grab the bed target temp before we turn heaters off so we know if it was an ABS print
    {% set bed_temp = printer.heater_bed.target|int %}

    # ------------------------------------------------------------------
    # 2. RETRACT & LIFT IMMEDIATELY
    # ------------------------------------------------------------------
    M400                                                   # Wait for all print moves to finish
    G92 E0                                                 # Zero the extruder
    G1 E-5.0 F3600                                         # Retract 5mm fast to prevent oozing (safe for Mosquito)
    
    G91                                                    # Switch to relative positioning
    G0 Z{z_safe} F3000                                     # Lift nozzle straight up off the print
    G90                                                    # Switch back to absolute positioning

    # ------------------------------------------------------------------
    # 3. SHUT DOWN HEATERS & PARK TOOLHEAD
    # ------------------------------------------------------------------
    TURN_OFF_HEATERS                                       # Turn off hotend and 750W bed heater
    M107                                                   # Turn off Stealthburner part cooling fan
    
    # Park toolhead at back-right corner (10mm away from physical max limits)
    G0 X{max_x - 10} Y{max_y - 10} F9000                   
    BED_MESH_CLEAR                                         # Clear active bed mesh

    # ------------------------------------------------------------------
    # 4. POST-PRINT AIR SCRUBBING (NEVERMORE)
    # ------------------------------------------------------------------
    {% if bed_temp > 90 %}
        M117 Scrubbing VOCs (10m)...
        SET_FAN_SPEED FAN=nevermore SPEED=1.0              # Keep Nevermore running at 100%
        SET_FAN_SPEED FAN=exhaust_fan SPEED=0.0            # Keep exhaust closed so Nevermore traps fumes
        G4 P600000                                         # Run scrub cycle for 10 minutes (600,000 ms)
    {% endif %}

    # Shut down filtration fans and finish
    SET_FAN_SPEED FAN=nevermore SPEED=0.0                  # Turn off Nevermore
    SET_FAN_SPEED FAN=exhaust_fan SPEED=0.0                # Turn off exhaust fan
    M117 Print Complete!


[idle_timeout]
timeout: 3600  # 1 hour timeout


# ======================================================================
# 1. HARDWARE DEFINITIONS (Verify pins against your Kraken & EBB pinouts)
# ======================================================================

[neopixel sb_leds]
pin: EBBCan:PD3                  # Check your EBB SB2209 RP2040 pinout (usually PD3 or GPIO16)
chain_count: 10                  # 8 Logo LEDs (BARF) + 2 Nozzle LEDs
color_order: GRBW                # Standard for Voron Stealthburner BARF + Nozzle LEDs
initial_RED: 0.2
initial_GREEN: 0.0
initial_BLUE: 0.2
initial_WHITE: 0.0

[neopixel chamber_leds]
pin: PF12                        # Check your BTT Kraken 1.1 RGB header pin (e.g., PF12 or PE6)
chain_count: 36                  # 2 sticks x 18 LEDs wired in series
color_order: GRB                 # Standard WS2812B strips (adjust to RGB if colors look swapped)
initial_RED: 0.3
initial_GREEN: 0.3
initial_BLUE: 0.3

# ======================================================================
# 2. BASE HELPER MACROS (Building blocks called by status macros)
# ======================================================================

[gcode_macro _SET_SB_LOGO]
description: Sets the color of the 8 BARF logo LEDs (Indexes 1 to 8)
gcode:
    {% set r = params.R|default(0)|float %}
    {% set g = params.G|default(0)|float %}
    {% set b = params.B|default(0)|float %}
    {% set w = params.W|default(0)|float %}

    # Loop through LEDs 1 to 8. TRANSMIT=0 buffers the change; TRANSMIT=1 sends it all at once
    {% for i in range(1, 9) %}
        SET_LED LED=sb_leds RED={r} GREEN={g} BLUE={b} WHITE={w} INDEX={i} TRANSMIT={1 if i == 8 else 0}
    {% endfor %}

[gcode_macro _SET_SB_NOZZLE]
description: Sets the 2 nozzle spotlight LEDs (Indexes 9 and 10)
gcode:
    {% set r = params.R|default(0)|float %}
    {% set g = params.G|default(0)|float %}
    {% set b = params.B|default(0)|float %}
    {% set w = params.W|default(0)|float %}

    SET_LED LED=sb_leds RED={r} GREEN={g} BLUE={b} WHITE={w} INDEX=9 TRANSMIT=0
    SET_LED LED=sb_leds RED={r} GREEN={g} BLUE={b} WHITE={w} INDEX=10 TRANSMIT=1

# ======================================================================
# 3. CHAMBER LIGHT CONTROLS (Buttons show up directly in Mainsail/Fluidd)
# ======================================================================

[gcode_macro CHAMBER_LIGHTS_ON]
description: Turns all 36 chamber LEDs on to bright neutral white
gcode:
    # No INDEX specified = updates all 36 LEDs in one instant command
    SET_LED LED=chamber_leds RED=0.8 GREEN=0.8 BLUE=0.8 TRANSMIT=1

[gcode_macro CHAMBER_LIGHTS_DIM]
description: Dims chamber LEDs to 25% for camera/night viewing
gcode:
    SET_LED LED=chamber_leds RED=0.25 GREEN=0.25 BLUE=0.25 TRANSMIT=1

[gcode_macro CHAMBER_LIGHTS_OFF]
description: Turns all 36 chamber LEDs off
gcode:
    SET_LED LED=chamber_leds RED=0.0 GREEN=0.0 BLUE=0.0 TRANSMIT=1

# ======================================================================
# 4. PRINTER STATUS MACROS (Drop these names into your PRINT_START / END)
# ======================================================================

[gcode_macro STATUS_READY]
description: Idle / Ready state (Soft Voron Purple logo, dim chamber)
gcode:
    _SET_SB_LOGO R=0.3 G=0.0 B=0.4 W=0.0
    _SET_SB_NOZZLE R=0.0 G=0.0 B=0.0 W=0.2
    CHAMBER_LIGHTS_DIM

[gcode_macro STATUS_HEATING]
description: Heating bed/nozzle or Heat Soaking (Warm Orange/Red)
gcode:
    _SET_SB_LOGO R=0.8 G=0.15 B=0.0 W=0.0
    _SET_SB_NOZZLE R=0.0 G=0.0 B=0.0 W=0.0
    SET_LED LED=chamber_leds RED=0.6 GREEN=0.1 BLUE=0.0 TRANSMIT=1

[gcode_macro STATUS_LEVELING]
description: Homing, QGL, and Adaptive Bed Meshing (Cyan/Teal)
gcode:
    _SET_SB_LOGO R=0.0 G=0.5 B=0.6 W=0.0
    _SET_SB_NOZZLE R=0.0 G=0.0 B=0.0 W=0.5

[gcode_macro STATUS_PRINTING]
description: Active Printing (Red Voron logo, bright white nozzle & chamber)
gcode:
    _SET_SB_LOGO R=0.8 G=0.0 B=0.0 W=0.0
    _SET_SB_NOZZLE R=0.0 G=0.0 B=0.0 W=1.0
    CHAMBER_LIGHTS_ON

[gcode_macro STATUS_DONE]
description: Print Finished (Bright Green status, dim chamber)
gcode:
    _SET_SB_LOGO R=0.0 G=0.8 B=0.0 W=0.0
    _SET_SB_NOZZLE R=0.0 G=0.0 B=0.0 W=0.0
    CHAMBER_LIGHTS_DIM

[gcode_macro STATUS_OFF]
description: Turns off all toolhead and chamber LEDs
gcode:
    _SET_SB_LOGO R=0.0 G=0.0 B=0.0 W=0.0
    _SET_SB_NOZZLE R=0.0 G=0.0 B=0.0 W=0.0
    CHAMBER_LIGHTS_OFF
[gcode_macro CLEAN_NOZZLE]
description: Wipes nozzle on back-left copper brush (1 inch above bed) with catch tray
gcode:
    # ==================================================================
    # 1. USER COORDINATES (Adjust these once printer is powered up!)
    # ==================================================================
    {% set start_x = 15.0 %}           # Left edge of the copper brush
    {% set end_x = 55.0 %}             # Right edge of the copper brush (40mm wide stroke)
    {% set brush_y = 345.0 %}          # Y center of the brush (back-left of 350mm bed)
    {% set tray_x = 5.0 %}             # X position over your glop catch tray (to the left of brush)

    # Z-HEIGHTS (CRITICAL: Your brush sticks up ~25.4mm / 1 inch above bed)
    {% set z_safe = 35.0 %}            # Safe travel height (10mm ABOVE brush/tray)
    {% set z_wipe = 24.0 %}            # Wiping height (nozzle tip grazing top of copper bristles)

    # WIPE SETTINGS
    {% set wipe_count = 6 %}           # Number of back-and-forth passes
    {% set wipe_speed = 9000 %}        # Wipe speed in mm/min (150 mm/s)

    # ==================================================================
    # 2. SAFETY CHECKS
    # ==================================================================
    # Ensure printer is homed before moving so we don't crash
    {% if "xyz" not in printer.toolhead.homed_axes %}
        G28
    {% endif %}

    # Save current G-code state (speeds, absolute/relative mode) so we restore it cleanly at the end
    SAVE_GCODE_STATE NAME=CLEAN_NOZZLE_STATE
    G90                                # Force absolute positioning

    # ==================================================================
    # 3. APPROACH & WIPE SEQUENCE
    # ==================================================================
    M117 Cleaning Nozzle...

    # Lift to Z35 FIRST before moving XY so we clear the 1-inch tall brush/tray
    {% if printer.toolhead.position.z < z_safe %}
        G1 Z{z_safe} F3000
    {% endif %}

    # Move over the catch tray first so any hanging ooze drops into the tray, not on the bed
    G1 X{tray_x} Y{brush_y} F9000

    # Drop down to wiping height (Z24)
    G1 Z{z_wipe} F3000

    # Scrub back and forth across the copper brush
    {% for i in range(wipe_count) %}
        G1 X{end_x} F{wipe_speed}      # Wipe right
        G1 X{start_x} F{wipe_speed}    # Wipe left
    {% endfor %}

    # Finish final stroke over the catch tray to knock any loose debris into the tray
    G1 X{tray_x} F{wipe_speed}

    # ==================================================================
    # 4. SAFE EXIT
    # ==================================================================
    # Lift back up to Z35 BEFORE moving away from the brush area
    G1 Z{z_safe} F3000

    RESTORE_GCODE_STATE NAME=CLEAN_NOZZLE_STATE
    M117 Nozzle Clean!


